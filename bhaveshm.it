<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Technical Festival Invitation</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-r from-blue-900 via-indigo-800 to-purple-900 flex items-center justify-center min-h-screen">

    <div class="bg-white rounded-3xl shadow-2xl p-10 max-w-3xl text-center border-4 border-yellow-400">

        <h1 class="text-5xl font-extrabold text-blue-900 mb-4">
            TECH FEST 2026
        </h1>

        <p class="text-xl text-gray-700 font-semibold mb-6">
            Annual Technical Festival
        </p>

        <div class="border-t-2 border-gray-300 my-6"></div>

        <h2 class="text-3xl font-bold text-purple-700 mb-4">
            You're Invited!
        </h2>

        <p class="text-gray-700 text-lg leading-8 mb-6">
            Join us for an exciting celebration of
            <span class="font-bold text-blue-700">Technology, Innovation, Robotics, Coding, AI, Gaming,</span>
            and many more exciting events.
            Students and Faculty are warmly invited to participate.
        </p>

        <div class="bg-blue-100 rounded-xl p-5 border border-blue-300 mb-6">
            <p class="text-lg"><strong>📅 Date:</strong> 15 September 2026</p>
            <p class="text-lg"><strong>🕘 Time:</strong> 9:00 AM onwards</p>
            <p class="text-lg"><strong>📍 Venue:</strong> College Auditorium</p>
        </div>

        <button class="bg-blue-600 hover:bg-blue-800 text-white font-bold py-3 px-8 rounded-full shadow-lg transition duration-300">
            Register Now
        </button>

        <button class="ml-4 bg-green-600 hover:bg-green-800 text-white font-bold py-3 px-8 rounded-full shadow-lg transition duration-300">
            Learn More
        </button>

    </div>

</body>
</html>